# TikTok Sandbox Credentials
#
# SECURITY: Never commit .env file to git (it's in .gitignore)
# This file is only for local development
#
# Get these from: https://developer.tiktok.com/console/apps
# → Your App → Basic Information

TIKTOK_CLIENT_ID=your_sandbox_client_id_here
TIKTOK_CLIENT_SECRET=your_sandbox_client_secret_here
