{
  "version": 2,
  "builds": [
    {
      "src": "tiktok-sandbox-backend.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "tiktok-sandbox-backend.js"
    }
  ],
  "env": {
    "TIKTOK_CLIENT_ID": "@tiktok_client_id",
    "TIKTOK_CLIENT_SECRET": "@tiktok_client_secret"
  },
  "public": false
}
