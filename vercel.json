{
  "version": 2,
  "builds": [
    {
      "src": "tiktok-sandbox-backend.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/**.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "tiktok-sandbox-backend.js"
    }
  ]
}
